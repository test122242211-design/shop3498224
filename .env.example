# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=
STAFF_LOG_CHANNEL_ID=1567845414160433172
TICKET_PANEL_CHANNEL_ID=1567839064848080906

# SellAuth
MYSELLAUTHAPI=
SELLAUTH_SHOP_ID=
SELLAUTH_API_BASE=https://api.sellauth.com/v1
# Set these to the exact paths shown in your SellAuth API docs.
# {invoiceId} is replaced with the customer-provided invoice ID.
SELLAUTH_INVOICE_PATH=/shops/{shopId}/invoices/{invoiceId}
SELLAUTH_COUPON_CREATE_PATH=/shops/{shopId}/coupons
# Optional: if the API response uses a different success field, adjust src/sellauth.js.
# Set the Netflix product's SellAuth product ID:
NETFLIX_PRODUCT_ID=

# OpenRouter
OPENROUTER_API_KEY=
# Use openrouter/free to let OpenRouter choose an available free model,
# or specify a model slug ending in :free.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://your-store.example
OPENROUTER_APP_NAME=OGSHOP Support

# Database: create a free PostgreSQL database at https://neon.tech
DATABASE_URL=

# Web server / Render
PORT=10000
# Optional override. If blank, the bot uses Render's RENDER_EXTERNAL_URL + /health automatically.
# The bot requests this URL every 60 seconds (best-effort; this does not guarantee a Free service stays awake).
PING_URL=

# Behaviour
AUTO_APPROVE_MINUTES=60
AI_MAX_HISTORY=12
